# Copy to .env and adjust. .env is gitignored; this file is committed with placeholders.

# Shared system-wide Postgres/PostGIS on :5432, dedicated 'placesfinder' database.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/placesfinder

# WGS84 lon/lat — standard for GPS and web maps. Change only if you know why.
SRID=4326

API_PREFIX=/api
CORS_ORIGINS=["http://localhost:5199"]
